{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ExternalAuth": {
    "ApiKeys": [ "development-external-key" ]
  },
  "AzureAd": {
    "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
    "Audience": "api://<api-client-id>"
  },
  "Tenants": [
    {
      "Id": "tenant-a",
      "Name": "Tenant A",
      "AllowedEndpoints": [ "ListAnimals", "GetAnimal" ],
      "EndpointAccess": {
        "ListAnimals": {
          "Roles": [ "Animals.Read" ],
          "Groups": []
        },
        "GetAnimal": {
          "Roles": [ "Animals.Read" ],
          "Groups": []
        }
      }
    },
    {
      "Id": "tenant-b",
      "Name": "Tenant B",
      "AllowedEndpoints": [ "ListAnimals", "GetAnimal", "CreateAnimal", "DeleteAnimal" ],
      "EndpointAccess": {
        "ListAnimals": {
          "Roles": [ "Animals.Read" ],
          "Groups": []
        },
        "GetAnimal": {
          "Roles": [ "Animals.Read" ],
          "Groups": []
        },
        "CreateAnimal": {
          "Roles": [ "Animals.Write" ],
          "Groups": [ "<entra-group-object-id>" ]
        },
        "DeleteAnimal": {
          "Roles": [ "Animals.Admin" ],
          "Groups": []
        }
      }
    }
  ],
  "AllowedHosts": "*"
}
