<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.9" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AppHost/**/*.cs" />
    <Compile Remove="InternalApi/**/*.cs" />
    <None Remove="AppHost/**/*.cs" />
    <None Remove="InternalApi/**/*.cs" />
  </ItemGroup>

</Project>
